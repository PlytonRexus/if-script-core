    "Face the consequences"
  __choice
__section

section__
  @title "Mercy Wins"

  markVisited(75)
  loyalty = loyalty + 2

  "Your opponent lowers their wand."
  ""
  "*You don't know what you've avoided.*"

  choice__
    @targetType "scene"
    @target 8
    "Leave together"
  __choice
__section

