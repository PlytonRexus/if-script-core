/* ===============================
   SCENE: THE FIRST DUEL
   =============================== */

scene__
  @name "The First Duel"
  @first 66
  @sections 66 67 68 69 70 71 72 73 74 75
__scene

section__
  @title "The Challenge Comes"

  markVisited(66)

  "A note slides under your door."
  ""
  "*Midnight. Trophy Room. Come alone.*"

  choice__
    @target 67
    "Go armed"
  __choice

  choice__
    @target 68
    "Bring no wand"
  __choice
__section

section__
  @title "Prepared"

  markVisited(67)
  courage = courage + 1

  "Your wand feels warm."
  ""
  "Too warm."

  choice__
    @target 69
    "Proceed"
  __choice
__section

section__
  @title "Unarmed"

