/* ============================================================
   THE ASHFORD CODEX — CHAPTER 11
   03-ch11-secret.partial.if

   Chapter 11: The Secret at the Heart of Things
   Fourth journal decode. Room of Hidden Things entry.
   Dark Arts temptation. Romance tension (Phase 2).
   Draco deterioration. Allegiance track check-in.

   Flags set: journal_decoded = 4, mirror_key_delayed (possibly),
   dark_arts_practiced (possibly), dark_network_access (possibly)

   Section range: A451–A500
   ============================================================ */

scene__
  @name "CH11: The Secret at the Heart of Things"
  @first "A451-CH11-Secret-Opens"
  @sceneTransition "dissolve"
  @sections "A451-CH11-Secret-Opens" "A452-CH11-Decode-Approach" "A453-CH11-Decode-Hermione" "A454-CH11-Decode-Luna" "A455-CH11-Decode-Alone" "A456-CH11-Fourth-Revealed" "A457-CH11-Room-Approach" "A458-CH11-Room-Entry" "A459-CH11-Draco-There" "A460-CH11-Room-Choice" "A461-CH11-Confront-Draco" "A462-CH11-Search-Quietly" "A463-CH11-Help-Draco" "A464-CH11-Room-Convergence" "A465-CH11-Key-Container" "A466-CH11-Containment-Charm" "A467-CH11-Dark-Hex" "A468-CH11-Legal-Method" "A469-CH11-Ask-Romance" "A470-CH11-Charm-Convergence" "A471-CH11-Romance-Tension-Hub" "A472-CH11-Elara-Tension" "A473-CH11-Elara-Tension-B" "A474-CH11-Marcus-Tension" "A475-CH11-Marcus-Tension-B" "A476-CH11-Jade-Tension" "A477-CH11-Jade-Tension-B" "A478-CH11-Sebastian-Tension" "A479-CH11-Sebastian-Tension-B" "A480-CH11-Romance-Confess" "A481-CH11-Romance-Deflect" "A482-CH11-Romance-Push-Back" "A483-CH11-No-Romance-Buffer" "A484-CH11-Romance-Convergence" "A485-CH11-Draco-Deterioration" "A486-CH11-Draco-Overheard" "A487-CH11-Draco-Mirror-Confirm" "A488-CH11-Track-Hub" "A489-CH11-Order-Check" "A490-CH11-Order-Name" "A491-CH11-Dark-Check" "A492-CH11-Dark-Delivery" "A493-CH11-Solo-Check" "A494-CH11-Solo-Plan" "A495-CH11-Track-Convergence" "A496-CH11-Weight" "A497-CH11-End-State" "A498-CH11-Chapter-Close" "A499-CH11-Buffer" "A500-CH11-To-Ch12"
__scene


/* ── 11a: FOURTH JOURNAL DECODE (A451–A456) ── */

section__
  @title "A451-CH11-Secret-Opens"
  @textPacing "cinematic"
  @shot "wide"

  "Late May. The light has changed — longer evenings, warmer stone, the specific golden quality of a Scottish spring that makes the castle look like it was painted rather than built. Students revise for exams in the courtyards. The institutional machinery of the school year continues to function."

  "Underneath the revision and the golden light: the war. The cabinet. The key. The allegiance you chose."

  "And the journal."

  "The journal's fourth section has been waiting. Three sections decoded — the first in October, the second in February, the third in April. Each one harder than the last, each one revealing another layer of Avery's investigation, each one coded to a different emotional key that requires you to feel the right thing before the ink will resolve."

  "The fourth section. The one that, according to the pattern, should reveal the Mirror-key's true nature."

  "You need help. Or you don't. But help is available."

  choice__
    @target "A452-CH11-Decode-Approach"
    "The fourth cipher."
  __choice
__section


section__
  @title "A452-CH11-Decode-Approach"
  @textPacing "cinematic"
  @shot "close"

  "The fourth section's cipher is different from the first three. The emotional key — the anchor Avery used to lock each section — has shifted from grief (section one) to anger (section two) to love (section three) to something you haven't identified yet."

  "The ink shimmers when you hold the page. Not the usual shimmer of charm-locked text — a deeper oscillation, as though the page itself is uncertain about whether to reveal its contents."

  "Three approaches. Three people who might help."

  choice__
    @target "A453-CH11-Decode-Hermione"
    @when hermione_saw_journal == true
    @disabledText "Hermione hasn't seen the journal — she can't help decode what she doesn't know exists."
    @action knowledge = adj(knowledge, 5)
    @action rel_hermione = adjRel(rel_hermione, 10)
    "Ask Hermione. She's seen the journal. Her analytical mind might identify the emotional key through theory rather than feeling."
  __choice

  choice__
    @target "A454-CH11-Decode-Luna"
    @when rel_luna >= 40
    @disabledText "Your relationship with Luna isn't strong enough for her to share her unusual insights. Requires relationship >= 40."
    @action empathy = adj(empathy, 5)
    @action rel_luna = adjRel(rel_luna, 10)
    "Ask Luna. She understood the journal's grief-charmed ink on the train. Her intuition operates on frequencies that analytical minds miss."
  __choice

  choice__
    @target "A455-CH11-Decode-Alone"
    @action knowledge = adj(knowledge, 8)
    @action cunning = adj(cunning, 3)
    "Decode alone. Six months of cipher work. You know Avery's notation better than anyone alive. Trust your own scholarship."
  __choice
__section


section__
  @title "A453-CH11-Decode-Hermione"
  @textPacing "cinematic"
  @shot "close"

  "Hermione meets you in the library. Restricted Section access — she has standing permission through her Potions research, and the librarian has long since stopped monitoring her movements through the shelves."

  "She examines the fourth section with the specific focus of someone who approaches problems through structure rather than intuition. She's brought reference texts — three volumes on emotional enchantment theory, one monograph on cipher construction in wartime correspondence."

  "'The emotional key,' she says, turning the page under a magnifying charm. 'The first three used primary emotions — grief, anger, love. The pattern suggests the fourth should use a complex emotion. Something that requires more than one feeling simultaneously.'"

  "'Like what.'"

  "'Guilt,' she says, without hesitation. 'Guilt is grief plus responsibility. Your parent was investigating something dangerous and chose to continue. The guilt of a parent who knows they might not come back.'"

  "She's right. You can feel it — the moment she names the emotion, the page's shimmer changes. Resolves. The ink begins to darken from its oscillating state into legibility."

  "'Hermione.'"

  "'Reading.'"

  "She reads alongside you. The fourth section opens."

  knowledge = adj(knowledge, 5)

  choice__
    @target "A456-CH11-Fourth-Revealed"
    "The section opens."
  __choice
__section


section__
  @title "A454-CH11-Decode-Luna"
  @textPacing "cinematic"
  @shot "close"

  "Luna meets you by the lake. She suggested the location — 'Water helps with emotional resonance. The lake has been listening to people's feelings for a thousand years. It knows the frequencies.'"

  "You've stopped questioning Luna's methodology. Her results are too consistent for dismissal."

  "She holds the journal page between her palms. Doesn't look at it — feels it. The way a musician tunes an instrument by vibration rather than sight."

  "'Oh,' she says. 'Your parent was feeling two things at once. That's why the cipher is harder. It's not one emotion. It's a chord.'"

  "'A chord.'"

  "'Grief and purpose. Not guilt — that's what people usually assume, that a parent who leaves feels guilty. But your parent didn't feel guilty. They felt the grief of choosing something that might cost them everything, and the purpose of knowing it had to be done anyway.'"

  "She opens her eyes."

  "'Grief-purpose. Hold both at once. Not one after the other — simultaneously. Like a chord.'"

  "You try. The feeling is: harder than any single emotion. Grief alone you could manage. Purpose alone you've been sustaining for six months. Both at once—"

  "The page resolves. The ink darkens. The fourth section opens."

  empathy = adj(empathy, 5)

  choice__
    @target "A456-CH11-Fourth-Revealed"
    "The chord holds."
  __choice
__section


section__
  @title "A455-CH11-Decode-Alone"
  @textPacing "cinematic"
  @shot "close"

  "Alone. The library. Late. The cipher notebook open, the journal's fourth section laid flat on the table, the magnifying charm hovering over the shimmer of unresolved ink."

  "Six months of this work. Six months of learning Avery's notation, Avery's emotional landscape, Avery's specific way of encoding information through feeling rather than mathematics. You are fluent now in a language that has exactly one other speaker — and that speaker is missing."

  "The emotional key. The first three were single emotions: grief, anger, love. The pattern suggests escalation — not a stronger single emotion, but something compounded."

  "You sit with the page. You let yourself feel."

  "What did Avery feel, writing this? Not grief — that was section one. Not rage at what they'd discovered — section two. Not the love that motivated the investigation — section three."

  "The fourth section was written last. The section Avery wrote knowing they might not come back. The section that contains the information too dangerous to encode lightly."

  "The feeling is: the specific clarity of someone who has accepted a cost they haven't yet paid. Not guilt. Not courage. Acceptance."

  "You hold the acceptance. The page resolves."

  knowledge = adj(knowledge, 8)

  choice__
    @target "A456-CH11-Fourth-Revealed"
    "The page resolves."
  __choice
__section


section__
  @title "A456-CH11-Fourth-Revealed"
  @textPacing "cinematic"
  @shot "extreme_close"

  "The fourth section of Avery Ashford's encrypted field journal. The ink dark now, stable, readable. The handwriting tight and precise — the handwriting of someone who is writing quickly because time is short."

  "*Section Four — The Key's Nature*"

  "*The obsidian shard is not a weapon. I was wrong about this for six months and the error nearly killed me. The Resonance Mirror does not amplify power. It amplifies INTENT.*"

  "*The shard — the Mirror-key — is inert until held by someone who understands what it does. Not knows — understands. The distinction matters. Knowledge is information. Understanding is information plus the willingness to act on it.*"

  "*Held by someone with destructive intent who genuinely understands the Mirror's function: it amplifies that destruction across multiple targets. This is what the Dark Lord wants it for. This is what he THINKS it does.*"

  "*But held by someone with protective intent — someone willing to sacrifice something of genuine value to protect others — it amplifies THAT instead. The Mirror doesn't choose sides. The holder does.*"

  "*The key is in Hogwarts. I confirmed its location before I was discovered. Room of Hidden Things. Near the vanishing cabinet cluster — ironic, given what that boy is building up there. Locked chest. Magical seal keyed to emotional resonance — you need to feel something TRUE to open it.*"

  "*I should have told Dumbledore. I should have told anyone. But the Mirror's nature means that the wrong person knowing about it is worse than no one knowing. And I no longer know who the wrong person is.*"

  "*If you're reading this, you've decoded four of five sections. The fifth — the last — contains the coordinates. Not the key's location. My location. Where I'll be if I survive what I'm about to do.*"

  "*I'm sorry for the cipher. I'm sorry for all of it. The protection was necessary. The cost of the protection was you, doing this work alone.*"

  "*Your parent loves you. Your parent is trying to come home.*"

  journal_decoded = 4

  choice__
    @target "A457-CH11-Room-Approach"
    "Section four. Decoded."
  __choice
__section


/* ── 11b: ROOM OF HIDDEN THINGS (A457–A464) ── */

section__
  @title "A457-CH11-Room-Approach"
  @textPacing "cinematic"
  @shot "medium"

  "The fourth section changes the picture. The Mirror-key is not what anyone thought it was. Not the Order, not the Death Eaters, not Dumbledore. Only Avery understood — and Avery is gone."

  "Intent, not power. Sacrifice, not violence. The key amplifies what the holder genuinely feels. Voldemort wants it for destruction — but unless he's willing to sacrifice something of real value, it won't work the way he expects."

  "This information is: dangerous. Because it means the key is potentially more powerful than anyone realised — in any direction. Protective or destructive. Depending entirely on who holds it and what they're willing to give up."

  "And the key is in the Room of Hidden Things. Where you confirmed its location in Chapter 10. Where Draco's Vanishing Cabinet sits in a different configuration of the same room."

  "You need to go back. Not for reconnaissance this time. For the key itself."

  knowledge = adj(knowledge, 8)

  choice__
    @target "A458-CH11-Room-Entry"
    "The seventh floor."
  __choice
__section


section__
  @title "A458-CH11-Room-Entry"
  @textPacing "cinematic"
  @shot "medium"

  "The seventh floor. After curfew. The corridor is empty — or should be."

  "You walk past the blank stretch of wall three times, thinking about hidden things. Not the cabinet. Not Draco's workshop. The vast repository. The centuries of concealment."

  "The door appears. You reach for the handle."

  "And stop."

  "Because someone is already inside. You can hear it — the faint sounds of movement, the specific acoustics of a person working in a large space. Footsteps on stone. The occasional mutter. A spell cast quietly."

  "Draco."

  "Not in his workshop configuration. In the Hidden Things configuration. He's in the same room you need to be in."

  choice__
    @target "A459-CH11-Draco-There"
    "He's here."
  __choice
__section


section__
  @title "A459-CH11-Draco-There"
  @textPacing "cinematic"
  @shot "close"

  "Through the cracked door: the Room of Hidden Things in its cathedral mode. Towers of objects. The broken cabinet. The tarnished tiara on its bust."

  "And Draco. Moving through the stacks with a list — parchment, held close, consulting it as he searches. He's looking for something. Not the Vanishing Cabinet — that's in a different configuration. He's looking for the same artefact his handlers ordered him to find."

  "The Mirror-key. He's searching for the Mirror-key."

  "He doesn't know exactly what he's looking for. The instructions from Bellatrix's intermediary were vague — 'an artefact of interest, old, stored in or near a small locked container.' But he's systematic. He's checking the locked chests and boxes methodically, working through the room section by section."

  "He hasn't reached the right chest yet. But he will. He's moving in the right direction."

  choice__
    @target "A460-CH11-Room-Choice"
    "The situation."
  __choice
__section


section__
  @title "A460-CH11-Room-Choice"
  @textPacing "cinematic"
  @shot "close"

  "Draco is searching for the key. You know where the key is. Two objectives colliding in the same room."

  "Three options."

  choice__
    @target "A461-CH11-Confront-Draco"
    @action courage = adj(courage, 8)
    "Confront him. Step into the room. Make your presence known. The direct approach — courageous, risky, potentially productive."
  __choice

  choice__
    @target "A462-CH11-Search-Quietly"
    @when cunning >= 65
    @disabledText "Requires Cunning >= 65 — the stealth and timing needed to search while Draco works are beyond your current skill."
    @action cunning = adj(cunning, 10)
    @action knowledge = adj(knowledge, 8)
    "Search quietly while he works. Move through the stacks on the opposite side. Reach the key's chest before he does. Never let him see you."
  __choice

  choice__
    @target "A463-CH11-Help-Draco"
    @when draco_helped == true
    @disabledText "You haven't built enough trust with Draco to offer help in this moment."
    @action rel_draco = adjRel(rel_draco, 20)
    @action morality = adj(morality, -5)
    "Help him first. He's clearly exhausted. Whatever he's looking for can wait — or you can redirect him while quietly locating the key yourself."
  __choice
__section


section__
  @title "A461-CH11-Confront-Draco"
  @textPacing "cinematic"
  @shot "close"

  "You push the door open. Step inside. The sound of your footsteps on the stone floor cuts through the room's dusty silence."

  "Draco spins. Wand up. The reflexes of someone who has been working under threat for nine months — the specific speed of a person who expects to be discovered and has rehearsed the response."

  "'It's me,' you say."

  "The wand lowers. Slowly. The recognition crosses his face — relief, then suspicion, then the complicated middle ground of someone who is both glad and afraid to see you."

  "'What are you doing here.'"

  "'Same thing you are. Looking for something in the Hidden Things.'"

  if__ (allegiance_track == "dark") {
    "He relaxes slightly. The shared complicity of the dark track — you're on his side, or close enough to it."

    "'The artefact,' he says. 'Bellatrix's secondary objective. I've been searching for hours. The room is — large.'"

    "'I know where it is.'"

    "His eyes widen."

    rel_draco = adjRel(rel_draco, 10)
  }

  if__ (allegiance_track == "order") {
    "He doesn't relax. The Order track — he doesn't know you're Order, but he senses the distance that allegiance creates."

    "'You shouldn't be here,' he says."

    "'Neither should you. But here we both are.'"

    "A pause. The specific silence of two people assessing each other's intentions."
  }

  if__ (allegiance_track == "solo") {
    "He doesn't relax, but he doesn't raise the wand again. The solo track — no allegiance to reveal, no side to declare."

    "'You keep turning up,' he says. 'The seventh floor is supposed to be mine.'"

    "'The school belongs to everyone, Draco. Even the hidden parts.'"
  }

  choice__
    @target "A464-CH11-Room-Convergence"
    "The confrontation holds."
  __choice
__section


section__
  @title "A462-CH11-Search-Quietly"
  @textPacing "cinematic"
  @shot "close"

  "You slip inside. Silent. The room is enormous — cathedral ceilings, towers of forgotten objects casting long shadows. Draco is on the far side, three rows of stacked furniture away, his attention fixed on a series of wooden crates."

  "You move through the stacks on the opposite side. Years of careful work — the cipher, the investigation, the specific patience that cunning requires — have trained you to move through spaces without drawing attention. Your footsteps match the room's ambient sounds. Your breathing is controlled."

  "The locked chest. You know its location from the reconnaissance in Chapter 10 — near the broken cabinet (not Draco's), beside the crates with the unknown symbol. You navigate to it by landmark, moving around the tiara's bust, past the stack of spell-damaged furniture."

  "There. The chest. Small, iron-banded, the lock glowing faintly with magical seal energy."

  "Draco is still on the other side of the room. He hasn't noticed you."

  "You crouch beside the chest. The seal pulses. The journal said: *keyed to emotional resonance. You need to feel something TRUE to open it.*"

  "True. Not specific. Not grief or anger or love. Just — truth. Genuine feeling."

  "You think of Avery. Not strategically. Not as the investigator thinking about the investigation's subject. As a child thinking about a missing parent."

  "The seal dissolves."

  cunning = adj(cunning, 5)

  choice__
    @target "A464-CH11-Room-Convergence"
    "The seal opens."
  __choice
__section


section__
  @title "A463-CH11-Help-Draco"
  @textPacing "cinematic"
  @shot "close"

  "You push the door open. He sees you. The wand comes up and then comes down — the recognition is faster now, the trust deeper than it was in October. You've been standing in corridors together for months."

  "'You look terrible,' you say."

  "'Observant as always.'"

  "'What are you looking for?'"

  "He shows you the list. Bellatrix's instructions, relayed through an intermediary's handwriting. *Artefact of interest. Old. Stored in or near a small locked container. Seventh floor, Room of Hidden Things configuration.*"

  "'I've been searching for three hours,' he says. 'The room is — absurd. There are hundreds of containers in here. Thousands. I can't—'"

  "He sits on a crate. The specific collapse of someone who has been holding themselves upright through discipline and has run out."

  "'I can help,' you say."

  "You search alongside him. Not toward the key — not yet. You search with him, checking the boxes and chests on his list, clearing sections of the room methodically. The work is: companionable. The specific companionship of two people doing a task together, even when the task serves an objective that only one of them fully understands."

  "After an hour, Draco stops. 'I need to sleep,' he says. 'I'll come back tomorrow.'"

  "He leaves. You stay."

  "Now you search for the real target."

  mirror_key_delayed = true

  choice__
    @target "A464-CH11-Room-Convergence"
    "He's gone. You search."
  __choice
__section


section__
  @title "A464-CH11-Room-Convergence"
  @textPacing "cinematic"
  @shot "close"

  "The chest. Whether you reached it through confrontation, stealth, or delayed search — you're here. Small, iron-banded, old. The lock's magical seal glows with a faint blue-white light that pulses like a heartbeat."

  if__ (mirror_key_delayed == false) {
    "The seal responds to genuine emotion — you've already felt it dissolve, or you stand before it now, reaching for the feeling that will open it."
  }

  if__ (mirror_key_delayed == true) {
    "Draco is gone. The room is yours. The seal responds to genuine emotion — the journal's instruction. You reach for the feeling."

    "The thought of Avery. Not strategy. Not investigation. The simple, unedited missing of someone who isn't here."

    "The seal dissolves."
  }

  "Inside the chest: darkness. Then, as your eyes adjust — a shape. Small. Obsidian-black. An angular shard of volcanic glass, perhaps three inches long, set into a fragment of ornate frame — gold leaf, tarnished, with tiny runes etched along the edges."

  "The Mirror-key."

  "It doesn't look like a weapon. It doesn't look like much of anything — a broken piece of something larger, something that was once whole and is now a fragment. But when your hand approaches it, you feel something. A resonance. A vibration in the air between your skin and the shard's surface."

  "The journal said: *intent.* The key responds to what you mean. Not what you want. What you *mean.*"

  "You don't touch it. Not yet. The question is what to do about the containment charm that surrounds it — a secondary ward, layered inside the chest, visible now as a faint lattice of silver-blue energy around the shard."

  choice__
    @target "A465-CH11-Key-Container"
    "The containment charm."
  __choice
__section


section__
  @title "A465-CH11-Key-Container"
  @textPacing "cinematic"
  @shot "extreme_close"

  "The containment charm. A secondary ward — Avery's work, probably, or someone earlier in the chain of people who have been protecting this object. The lattice is tight, precise, professionally constructed. Not the work of a student."

  "Breaking it will require either force or finesse. Dark magic or careful, legal spellwork. Or help."

  choice__
    @target "A466-CH11-Containment-Charm"
    "Assess the charm."
  __choice
__section


section__
  @title "A466-CH11-Containment-Charm"
  @textPacing "cinematic"
  @shot "extreme_close"

  "The containment lattice. Three options."

  choice__
    @target "A467-CH11-Dark-Hex"
    @action knowledge = adj(knowledge, 5)
    @action morality = adj(morality, -20)
    @action dark_arts_practiced = true
    "Use a Dark hex. A Shattering Curse — the kind of spell that is effective, illegal, and leaves a mark on the caster's magical signature that never fully fades. The fastest method. The darkest."
  __choice

  choice__
    @target "A468-CH11-Legal-Method"
    @when knowledge >= 60
    @disabledText "Requires Knowledge >= 60 — the legal counter-charm sequence is advanced NEWT-level work."
    @action knowledge = adj(knowledge, 10)
    @action morality = adj(morality, 5)
    @action courage = adj(courage, 3)
    "Use a legal counter-charm sequence. Slower. Harder. Requires advanced magical knowledge. But leaves no dark trace."
  __choice

  choice__
    @target "A469-CH11-Ask-Romance"
    @when romance_active != ""
    @disabledText "No one close enough to trust with this."
    @action empathy = adj(empathy, 8)
    "Ask your romance partner for help. Two wands are better than one, and the trust required to share this moment is its own form of strength."
  __choice
__section


section__
  @title "A467-CH11-Dark-Hex"
  @textPacing "cinematic"
  @shot "extreme_close"

  "The Shattering Curse. You know the incantation — you've read it, studied the theory, understood the mechanics. You've never cast it. The first time is always the hardest, because the first time is the time you cross the line between knowing and doing."

  "The wand movement is sharp. Precise. The incantation is three syllables of Latin that the Ministry classifies as restricted — not Unforgivable, but in the same neighbourhood. The kind of spell that gets you questioned if detected."

  "The curse hits the containment lattice. The lattice doesn't dissolve — it shatters. The difference is significant. A legal counter-charm would have unwoven the lattice thread by thread, leaving the enchantment's structure intact for future use. The Shattering Curse destroys it. Permanently. Violently."

  "The obsidian shard sits in the broken chest, uncontained. The resonance is stronger now — a low hum in your bones, the vibration of an object that has been locked away for decades and is suddenly free."

  "You've cast a Dark hex. The magical signature is on your wand. On you. The line between knowing about Dark magic and practising it — you've crossed it."

  "The feeling is: clarity. And underneath the clarity: a coldness that wasn't there before."

  if__ (morality <= 40) {
    dark_network_access = true
  }

  choice__
    @target "A470-CH11-Charm-Convergence"
    "The shard is free."
  __choice
__section


section__
  @title "A468-CH11-Legal-Method"
  @textPacing "cinematic"
  @shot "close"

  "The legal method. NEWT-level counter-charm work — a sequence of seven precise incantations delivered in the correct order, each one unweaving a thread of the containment lattice without damaging the underlying structure."

  "It takes forty minutes. Forty minutes of sustained concentration, careful wand work, and the specific patience that legal magic requires — the patience of doing something the right way when the fast way is available and tempting."

  "Thread by thread. The lattice loosens. The enchantment's structure becomes visible as you disassemble it — Avery's work, you recognise now, the same careful notation that characterises the journal's cipher. Your parent built this containment. You are undoing it with the same precision."

  "The final thread dissolves. The lattice fades. The obsidian shard sits in the chest, uncontained, humming with a low resonance that you can feel in your teeth."

  "You did it the right way. The slow way. The way that leaves no dark trace on your magical signature. The way Avery would have done it."

  choice__
    @target "A470-CH11-Charm-Convergence"
    "The shard is free."
  __choice
__section


section__
  @title "A469-CH11-Ask-Romance"
  @textPacing "cinematic"
  @shot "close"

  "You go to them. The person you've been letting in. The person whose trust you're about to test with the weight of what you've found."

  if__ (romance_active == "elara") {
    "Elara. You find her in the library — where else — and you tell her. Not everything. Enough. The key. The charm. The need for help."

    "She doesn't hesitate. 'Show me,' she says, and closes the book she was reading with the specific decisiveness of someone who has been waiting to be needed."

    "Together, in the Room of Hidden Things, her wand complements yours. She takes the analytical approach — identifying the charm's architecture, mapping its weak points. You provide the emotional resonance the charm requires. Two minds. Two methods. The lattice comes apart in twenty minutes."

    rel_elara = adjRel(rel_elara, 10)
  }

  if__ (romance_active == "marcus") {
    "Marcus. The corridor. You tell him what you need — not why, not yet, just the practical requirement. Two wands on a containment charm."

    "He comes without asking questions. The specific trust of someone who has learned that your requests, however cryptic, are never trivial."

    "In the Room, his Slytherin training shows. He recognises the charm's structure — 'Old Ministry work,' he says. 'My family has similar wards on the manor.' The knowledge of the Dark side, applied to undoing rather than maintaining. The lattice comes apart in fifteen minutes."

    rel_marcus = adjRel(rel_marcus, 10)
  }

  if__ (romance_active == "jade") {
    "Jade. The Quidditch pitch. You pull her from the air — literally, a Patronus message that brings her landing beside you with the specific curiosity of someone who never refuses an adventure."

    "'This had better be good,' she says, broomstick over her shoulder."

    "In the Room, her approach is pure Gryffindor: direct, brave, willing to push against the charm's resistance with raw magical force guided by your more careful technique. Brute strength and precision. The lattice comes apart in twenty-five minutes."

    rel_jade = adjRel(rel_jade, 10)
  }

  if__ (romance_active == "sebastian") {
    "Sebastian. The common room. Tea, as always. You tell him — the key, the charm, the help you need."

    "'Of course,' he says. He doesn't ask why. He doesn't need to understand the full picture before deciding to help. The trust is: structural. Pre-existing. The foundation of everything else."

    "In the Room, his approach is steady. Patient. He holds the charm's energy stable while you unweave the threads — the magical equivalent of someone holding a door open while you carry something heavy through it. The lattice comes apart in thirty minutes."

    rel_sebastian = adjRel(rel_sebastian, 10)
  }

  "The shard is free. And someone else now knows it exists."

  choice__
    @target "A470-CH11-Charm-Convergence"
    "The shard is free."
  __choice
__section


section__
  @title "A470-CH11-Charm-Convergence"
  @textPacing "cinematic"
  @shot "close"

  "The obsidian shard. The Mirror-key. Free of its containment. Sitting in the broken chest in the Room of Hidden Things."

  "You don't take it yet. The journal's warning — *held by someone who understands* — echoes. You understand the theory. Do you understand the key? Understanding, Avery wrote, requires willingness to act. Not just knowledge."

  "You leave the key in the chest. The containment is broken but the chest still conceals it. For now, its location is known only to you — and whoever helped you, if anyone did."

  "The retrieval decision can wait. The urgency is knowledge, not possession."

  "You close the chest. Leave the room. The door vanishes behind you."

  "The seventh floor corridor is empty. The castle sleeps."

  choice__
    @target "A471-CH11-Romance-Tension-Hub"
    "The key waits."
  __choice
__section


/* ── 11c: ROMANCE PHASE 2 — TENSION (A471–A484) ── */

section__
  @title "A471-CH11-Romance-Tension-Hub"
  @textPacing "cinematic"
  @shot "medium"

  "The days after the key. The investigation deepening. And underneath the investigation — the person."

  "Romance Phase 2: the tension. The point in every relationship where the lies you've been maintaining — or the truths you've been avoiding — become unsustainable. Where the person who has been letting you in discovers that what they're being let into is more complicated and more dangerous than they realised."

  if__ (romance_active == "elara") {
    choice__
      @target "A472-CH11-Elara-Tension"
      "Elara's tension."
    __choice
  }

  if__ (romance_active == "marcus") {
    choice__
      @target "A474-CH11-Marcus-Tension"
      "Marcus's tension."
    __choice
  }

  if__ (romance_active == "jade") {
    choice__
      @target "A476-CH11-Jade-Tension"
      "Jade's tension."
    __choice
  }

  if__ (romance_active == "sebastian") {
    choice__
      @target "A478-CH11-Sebastian-Tension"
      "Sebastian's tension."
    __choice
  }

  if__ (romance_active == "") {
    choice__
      @target "A483-CH11-No-Romance-Buffer"
      "No one waiting."
    __choice
  }
__section


section__
  @title "A472-CH11-Elara-Tension"
  @textPacing "cinematic"
  @shot "close"

  "Elara has been watching you. Not the casual observation of a classmate — the focused, analytical attention of someone who processes the world through patterns and has noticed that your patterns have changed."

  "'You're lying to me,' she says. The library. Their corner. The one that has become geography."

  "Not accusatory. Observational. The tone of someone who is stating a finding, not making a charge."

  "'Not lying,' you say. 'Omitting.'"

  "'The distinction between those two things is smaller than you think it is. I've been — I've been counting. The number of times you've redirected a conversation. The number of times you've answered a question with a different question. The number of times you've been somewhere you said you weren't going to be. It's a pattern. And patterns are data.'"

  "She's right. She's been right about most things since September. The analytical mind that makes her formidable in class makes her formidable in this too."

  "'I'm asking you,' she says. 'Not as someone who is trying to catch you. As someone who is — involved. With you. And the involvement requires honesty or it doesn't work.'"

  choice__
    @target "A473-CH11-Elara-Tension-B"
    "She's asking."
  __choice
__section


section__
  @title "A473-CH11-Elara-Tension-B"
  @textPacing "cinematic"
  @shot "extreme_close"

  "The tension. The specific moment where the romance meets the investigation and one of them has to give."

  choice__
    @target "A480-CH11-Romance-Confess"
    @action empathy = adj(empathy, 12)
    @action rel_elara = adjRel(rel_elara, 25)
    @action romance_active = "elara"
    "Tell her. Not everything — not the key, not the allegiance specifics — but the investigation. The journal. The cipher. Avery. The reason for the lies. Trust her with the weight you've been carrying."
  __choice

  choice__
    @target "A481-CH11-Romance-Deflect"
    @action rel_elara = adjRel(rel_elara, -10)
    @action cunning = adj(cunning, 5)
    "Deflect. You can't tell her. The investigation is too dangerous to share. The omissions protect her — or that's what you tell yourself."
  __choice

  choice__
    @target "A482-CH11-Romance-Push-Back"
    @action courage = adj(courage, 5)
    @action empathy = adj(empathy, 5)
    @action rel_elara = adjRel(rel_elara, 10)
    "Push back gently. 'I'm not lying to you. I'm not ready to tell you everything. Those are different. And when I am ready, you'll be the first person I tell.'"
  __choice
__section


section__
  @title "A474-CH11-Marcus-Tension"
  @textPacing "cinematic"
  @shot "close"

  "Marcus. The corridor. Always the corridor."

  "But tonight the corridor feels different. Smaller. The torchlight catches his face and you see something you haven't seen before — not the careful composure of someone managing a dangerous position, but the raw edge underneath it. The place where the composure wears thin."

  "'I need to tell you something,' he says. 'And you need to decide what to do with it.'"

  "'Go ahead.'"

  "'My family's people — the Death Eater network — they know about you. Not specifically. Not your name. But they know someone at Hogwarts is investigating the Mirror. The information came from — I don't know where. But it's in the network. And the instruction is: find them. Stop them.'"

  "The information lands with the specific weight of a threat that has moved from theoretical to operational."

  "'How long have you known.'"

  "'Two days. I've been trying to decide whether to tell you. Because telling you means — choosing. Properly choosing. My family's side or yours. The information flowing to them or to you. I can't do both anymore.'"

  choice__
    @target "A475-CH11-Marcus-Tension-B"
    "He's choosing."
  __choice
__section


section__
  @title "A475-CH11-Marcus-Tension-B"
  @textPacing "cinematic"
  @shot "extreme_close"

  "The tension. Marcus between two worlds. You, the reason he's choosing."

  choice__
    @target "A480-CH11-Romance-Confess"
    @action empathy = adj(empathy, 12)
    @action rel_marcus = adjRel(rel_marcus, 25)
    @action romance_active = "marcus"
    "Tell him the truth. The investigation. Avery. The key. He's risking his family's wrath to warn you — the least you can give him is honesty about what he's protecting."
  __choice

  choice__
    @target "A481-CH11-Romance-Deflect"
    @action rel_marcus = adjRel(rel_marcus, -10)
    @action cunning = adj(cunning, 5)
    "Deflect. Accept the warning without reciprocating the vulnerability. The intelligence is useful. The trust — that's harder to give."
  __choice

  choice__
    @target "A482-CH11-Romance-Push-Back"
    @action courage = adj(courage, 5)
    @action empathy = adj(empathy, 5)
    @action rel_marcus = adjRel(rel_marcus, 10)
    "Push back gently. 'Thank you for telling me. I'm not ready to tell you everything. But the fact that you chose to warn me — I won't forget that. And when this is over, I'll explain.'"
  __choice
__section


section__
  @title "A476-CH11-Jade-Tension"
  @textPacing "cinematic"
  @shot "close"

  "Jade. The Quidditch pitch. Always the Quidditch pitch."

  "She's waiting for you on the lower stands. No broom today. Just her, sitting with her knees drawn up, looking at the pitch the way she looks at it when she's thinking about things that aren't Quidditch — which means she's thinking about things that are serious, because for Jade, Quidditch is the default and everything else requires a specific effort of attention."

  "'I know you've been going to the seventh floor,' she says."

  "The statement is: surprising. Jade is not an investigator. Jade is not a pattern-watcher. Jade is the person who tackles problems head-on, who flies straight rather than circling. For her to have noticed something covert means it was either very obvious or she's been paying a different kind of attention."

  "'How do you know that.'"

  "'Because I follow you sometimes. Not in a — not in a weird way. In a worried way. You disappear at night and come back looking like you've been carrying something heavy and I worry about you and the worry makes me — follow.'"

  "She looks at her hands."

  "'I'm not asking you to stop whatever you're doing. I'm asking you to tell me enough that I stop worrying. Because the worrying is — it's a lot.'"

  choice__
    @target "A477-CH11-Jade-Tension-B"
    "She's worried."
  __choice
__section


section__
  @title "A477-CH11-Jade-Tension-B"
  @textPacing "cinematic"
  @shot "extreme_close"

  "Jade's tension. Not intellectual, like Elara's. Not dangerous, like Marcus's. Emotional. The worry of someone whose primary language is action and who can't act on this."

  choice__
    @target "A480-CH11-Romance-Confess"
    @action empathy = adj(empathy, 12)
    @action rel_jade = adjRel(rel_jade, 25)
    @action romance_active = "jade"
    "Tell her. The investigation. Avery. The key. The reason for the midnight absences. She's been following you out of love — the least you owe her is the truth about where she's been following you to."
  __choice

  choice__
    @target "A481-CH11-Romance-Deflect"
    @action rel_jade = adjRel(rel_jade, -10)
    @action cunning = adj(cunning, 5)
    "Deflect. 'It's school stuff. Extra research. Nothing dangerous.' The lie is gentle. It's also a lie."
  __choice

  choice__
    @target "A482-CH11-Romance-Push-Back"
    @action courage = adj(courage, 5)
    @action empathy = adj(empathy, 5)
    @action rel_jade = adjRel(rel_jade, 10)
    "Push back gently. 'I can't tell you what it is yet. But I need you to trust that I'm being careful, and when I can tell you, I will. Can you trust that?'"
  __choice
__section


section__
  @title "A478-CH11-Sebastian-Tension"
  @textPacing "cinematic"
  @shot "close"

  "Sebastian. The common room. Tea."

  "But the tea tonight is different. He's made the cup — yours, the one he always uses for you, the blue one with the chipped handle — but he's not drinking his own. He's holding it. Warming his hands on a cup he doesn't intend to drink."

  "'I know you're doing something dangerous,' he says."

  "Not angry. Not accusatory. The tone is: the specific gentleness of someone who has decided to say a hard thing and is going to say it as carefully as they can."

  "'I don't know what it is. I've been — I've been trying not to know. Because if I know, then I worry, and if I worry, then you notice that I worry, and then you feel guilty about making me worry, and the guilt makes you pull away, and the pulling away makes me worry more. It's a loop. I've been trying to break the loop by not knowing.'"

  "He puts the cup down."

  "'But the loop is breaking anyway. Because you come back from wherever you go at night and your hands shake for twenty minutes and you think I don't notice but I notice everything about you and the shaking is getting worse.'"

  choice__
    @target "A479-CH11-Sebastian-Tension-B"
    "He notices."
  __choice
__section


section__
  @title "A479-CH11-Sebastian-Tension-B"
  @textPacing "cinematic"
  @shot "extreme_close"

  "Sebastian's tension. The quiet kind. The kind that doesn't demand — it waits. It stays. It holds the blue cup with the chipped handle and tells you it notices."

  choice__
    @target "A480-CH11-Romance-Confess"
    @action empathy = adj(empathy, 12)
    @action rel_sebastian = adjRel(rel_sebastian, 25)
    @action romance_active = "sebastian"
    "Tell him. Everything. The journal. The cipher. Avery. The key. The seventh floor. The allegiance. All of it. He's been carrying the weight of not knowing — give him the weight of knowing instead. Let him choose which is heavier."
  __choice

  choice__
    @target "A481-CH11-Romance-Deflect"
    @action rel_sebastian = adjRel(rel_sebastian, -10)
    @action cunning = adj(cunning, 5)
    "Deflect. 'The shaking is — exam stress. You know how I get.' The lie is unconvincing. You both know it's unconvincing. He lets you tell it anyway, because that's what Sebastian does."
  __choice

  choice__
    @target "A482-CH11-Romance-Push-Back"
    @action courage = adj(courage, 5)
    @action empathy = adj(empathy, 5)
    @action rel_sebastian = adjRel(rel_sebastian, 10)
    "Push back gently. 'You're right. Something is happening. I can't tell you what yet. But the fact that you asked — that you noticed — I need you to know that matters. You matter.'"
  __choice
__section


section__
  @title "A480-CH11-Romance-Confess"
  @textPacing "cinematic"
  @shot "close"

  "You tell them."

  "Not everything. Not the allegiance specifics — that's too dangerous to share, for them and for you. But the investigation. The journal. Avery. The cipher. The Mirror-key. The reason for the midnight absences and the shaking hands and the lies."

  "You tell them, and the telling is: relief. The specific relief of a weight shared. Not halved — shared. The weight is the same. But two people carrying it is different from one."

  "They listen. The listening is different for each of them — Elara processes analytically, Marcus processes tactically, Jade processes through the lens of action and response, Sebastian processes through the lens of care — but the outcome is the same: they know."

  "And knowing, they choose to stay."

  "'I'm in,' they say. Or words to that effect. The specific formulation varies, but the meaning doesn't. *I know what this is now. I'm staying.*"

  "The romance is confirmed. Not consummated — that comes later, if it comes. But confirmed. Two people who have looked at each other's complications and decided that the complications are worth the person."

  choice__
    @target "A484-CH11-Romance-Convergence"
    "They stay."
  __choice
__section


section__
  @title "A481-CH11-Romance-Deflect"
  @textPacing "cinematic"
  @shot "close"

  "You deflect. The specific skill of someone who has been managing information flow for six months — the redirect, the half-truth, the answer that satisfies the question without revealing the answer."

  "They accept it. Or they don't accept it — they note it, file it, add it to the pattern of omissions that has been building since October. The deflection is: functional. It preserves the operational security of the investigation."

  "It also damages the trust. Not catastrophically — not yet — but measurably. The specific erosion of confidence that happens when someone asks for honesty and receives evasion."

  "They walk away. Or they stay, but the staying has a different quality — the quality of someone who is present but no longer fully invested in the conversation, because the conversation didn't invest in them."

  "The investigation is protected. The relationship is: thinner."

  choice__
    @target "A484-CH11-Romance-Convergence"
    "The deflection holds."
  __choice
__section


section__
  @title "A482-CH11-Romance-Push-Back"
  @textPacing "cinematic"
  @shot "close"

  "The push-back. Not deflection — not dishonesty. Honesty about the dishonesty. The specific vulnerability of saying 'I can't tell you yet' instead of pretending there's nothing to tell."

  "They hear it. The distinction between 'I'm lying to you' and 'I'm not ready to tell you the truth' — it's thin, but it's real, and they hear it."

  "'Okay,' they say. Or a version of okay. The acceptance is conditional — not indefinite, not a blank cheque of patience. But enough. Enough for now."

  "The trust holds. Not deepened, the way full confession would deepen it. But not eroded, the way deflection would erode it. Maintained. The specific, precarious maintenance of a relationship where one person is carrying a weight the other person can see but can't share yet."

  "Later. You'll tell them later. That's the promise. Whether it's a promise you can keep — that depends on what happens next."

  choice__
    @target "A484-CH11-Romance-Convergence"
    "Later."
  __choice
__section


section__
  @title "A483-CH11-No-Romance-Buffer"
  @textPacing "cinematic"
  @shot "medium"

  "No romance. The tension phase — the part of the story where relationships are tested by the weight of what you're carrying — manifests differently for someone who is carrying the weight alone."

  "You walk the castle. The corridors at midnight. The specific solitude of someone whose primary relationship is with an investigation."

  "Luna finds you. Not deliberately — Luna's movements through the castle have the quality of weather patterns rather than intentional navigation. She drifts into your corridor like a cloud crossing the sun."

  "'You found something,' she says. Not a question."

  "'How do you know.'"

  "'Your Wrackspurts changed. They were confused before. Now they're — purposeful. Like they know where they're going but haven't decided whether to take you with them.'"

  "You don't ask what Wrackspurts are. You've learned that with Luna, the metaphor is the message."

  "'Be careful with purposeful things,' she says. 'They have their own momentum.'"

  "She drifts away. The corridor is empty again."

  rel_luna = adjRel(rel_luna, 5)

  choice__
    @target "A484-CH11-Romance-Convergence"
    "The corridor clears."
  __choice
__section


section__
  @title "A484-CH11-Romance-Convergence"
  @textPacing "cinematic"
  @shot "medium"

  "The romance tension phase resolves — confession, deflection, or gentle deferral. The relationships have shifted. The investigation continues with or without the person you've been letting in."

  "What follows: the world outside the relationship. The war. The deterioration."

  choice__
    @target "A485-CH11-Draco-Deterioration"
    "Draco."
  __choice
__section


/* ── 11d: DRACO DETERIORATION (A485–A487) ── */

section__
  @title "A485-CH11-Draco-Deterioration"
  @textPacing "cinematic"
  @shot "close"

  "Draco is deteriorating."

  "The word is clinical and accurate. The process has been visible all year — the weight loss, the sleeplessness, the shaking hands, the specific pallor of someone whose body is responding to sustained psychological pressure by shutting down the non-essential systems. But in the last two weeks, the deterioration has accelerated."

  "He missed Potions. Draco Malfoy missed Potions — the class his godfather teaches, the class where his performance has been automatic and reliable since first year. The absence was noticed. Slughorn made a comment. Snape said nothing, which was its own kind of comment."

  "In the corridors, he walks close to walls. His eyes track movement — not casually, the way students track each other, but the way people track threats. Every doorway assessed. Every approaching figure evaluated."

  "The cabinet is nearly finished. The people who will come through it are nearly here. And Draco is running out of time, running out of weight, running out of the specific resource that allows a sixteen-year-old to hold themselves together while building a weapon."

  choice__
    @target "A486-CH11-Draco-Overheard"
    "You overhear something."
  __choice
__section


section__
  @title "A486-CH11-Draco-Overheard"
  @textPacing "cinematic"
  @shot "close"

  "The overheard conversation. Not in the corridor — in the bathroom. Moaning Myrtle's bathroom, the one on the second floor, the one that no one uses because Myrtle's presence makes the space uncomfortable for the living."

  "You're passing the door. You hear voices. One is Myrtle's — the high, petulant tone that is her default register. The other is Draco's."

  "You stop. You listen."

  "'— can't do it,' Draco is saying. 'The cabinet works. It's done. But the next part — the actual — I can't—'"

  "'You could not do it,' Myrtle says. Her voice is unusually gentle. Myrtle is not known for gentleness, which means the situation has reached a severity that even a ghost who has been dead for fifty years recognises as genuine."

  "'If I don't do it, they kill my mother.'"

  "Silence."

  "'They told me. Specifically. Aunt Bella — she said it plainly. The way she says everything plainly. If the task isn't completed, Narcissa pays. That's the mechanism. That's the lever.'"

  "More silence. Then: the sound of someone crying. Quiet. Controlled. The crying of a person who has been controlling everything for nine months and has found the one room where they can stop."

  draco_mirror_hint = true

  choice__
    @target "A487-CH11-Draco-Mirror-Confirm"
    "You heard."
  __choice
__section


section__
  @title "A487-CH11-Draco-Mirror-Confirm"
  @textPacing "cinematic"
  @shot "close"

  "You heard. The scope of Draco's position — the specific mechanics of the leverage being applied to him. Not abstract coercion. Concrete threat. His mother's life."

  "And underneath the personal threat: the confirmation. The cabinet is done. The passage is open. The Death Eaters will come through. The target is Dumbledore. And Draco is the mechanism — or is supposed to be."

  "The Mirror-key. Draco's handlers want it found. The Death Eaters who come through the cabinet will have a secondary objective: retrieve the artefact. The key you've already located. The key whose containment charm you already broke."

  "The timelines are converging. The cabinet. The key. Draco. Dumbledore. All of it accelerating toward the same point."

  "The question is: what do you do with what you know."

  knowledge = adj(knowledge, 5)

  choice__
    @target "A488-CH11-Track-Hub"
    "The tracks diverge."
  __choice
__section


/* ── 11e: ALLEGIANCE TRACK CHECK-IN (A488–A495) ── */

section__
  @title "A488-CH11-Track-Hub"
  @textPacing "cinematic"
  @shot "medium"

  "The allegiance track. The choice you made in Chapter 10, now tested by new intelligence."

  if__ (allegiance_track == "order") {
    choice__
      @target "A489-CH11-Order-Check"
      "The Order's response."
    __choice
  }

  if__ (allegiance_track == "dark") {
    choice__
      @target "A491-CH11-Dark-Check"
      "Draco's world."
    __choice
  }

  if__ (allegiance_track == "solo") {
    choice__
      @target "A493-CH11-Solo-Check"
      "The solo investigator."
    __choice
  }
