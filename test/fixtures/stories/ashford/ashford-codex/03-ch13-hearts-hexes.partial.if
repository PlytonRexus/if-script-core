  @name "CH13: Hearts and Hexes"
  @first "A546-CH13-Hearts-Hexes-Opens"
  @sceneTransition "dissolve"
  @sections "A546-CH13-Hearts-Hexes-Opens" "A547-CH13-Spy-Hub" "A548-CH13-Spy-Exposed-Scene" "A549-CH13-Spy-Leveraged-Scene" "A550-CH13-Spy-Protected-Scene" "A551-CH13-Spy-Unknown-Scene" "A552-CH13-Asha-Hurt" "A553-CH13-Asha-Response" "A554-CH13-Spy-Convergence" "A555-CH13-Luna-Hub" "A556-CH13-Luna-Dinner" "A557-CH13-Luna-Ask" "A558-CH13-Luna-Listen" "A559-CH13-Luna-Dismiss" "A560-CH13-Luna-Convergence" "A561-CH13-Romance-Phase3-Hub" "A562-CH13-Elara-Phase3" "A563-CH13-Elara-Phase3-Choice" "A564-CH13-Elara-Anger" "A565-CH13-Elara-Understand" "A566-CH13-Elara-Kiss" "A567-CH13-Marcus-Phase3" "A568-CH13-Marcus-Phase3-Choice" "A569-CH13-Marcus-Stand" "A570-CH13-Marcus-Hide" "A571-CH13-Marcus-Sacrifice" "A572-CH13-Jade-Phase3" "A573-CH13-Jade-Phase3-Choice" "A574-CH13-Jade-Let-Go" "A575-CH13-Jade-Stay" "A576-CH13-Jade-Third-Way" "A577-CH13-Sebastian-Phase3" "A578-CH13-Sebastian-Phase3-Choice" "A579-CH13-Sebastian-Clean" "A580-CH13-Sebastian-Lie" "A581-CH13-Sebastian-Push-Away" "A582-CH13-No-Romance-Phase3" "A583-CH13-Romance-Phase3-Convergence" "A584-CH13-Track-Hub" "A585-CH13-Order-Assignment" "A586-CH13-Order-Assignment-B" "A587-CH13-Dark-Acceleration" "A588-CH13-Dark-Acceleration-B" "A589-CH13-Solo-Forward" "A590-CH13-Solo-Forward-B" "A591-CH13-Track-Convergence" "A592-CH13-End-State" "A593-CH13-Chapter-Close" "A594-CH13-Buffer" "A595-CH13-To-Ch14"
