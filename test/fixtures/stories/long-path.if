  "In the hollows of the throne a whisper says: 'Bring what is small and heavy; bind it or break it.' You feel the ring grow warm."
  if__ (carryingRing == true) {
    courage = courage - 2
    lore = lore + 1
  }

  choice__
    @target 89
    "Talk with your companions about it"
  __choice
