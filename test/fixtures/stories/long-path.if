  choice__
    @target 97
    "Use the image to guide your next step"
  __choice
__section

section__
  @title "96 — The Ring's Resistance"

  "The ring will not burn. It slides from the pyre and hides in a crack; its song thrums in your bones."
  carryingRing = true
  courage = courage - 2

  choice__
    @target 97
    "Collect the ring and flee"
