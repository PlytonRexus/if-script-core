  lore = lore + 2

  choice__
    @target 95
    "Seek the singing stone"
  __choice
__section

section__
  @title "94 — Against the Flame"

  "As the fire eats at the ring, the air screams like a caged thing. The ring bites at resolve and pulls at thoughts of glory."
  if__ (courage >= 12) {
    "You hold your hand steady. The ring flares then dims, and the fire accepts it."
    carryingRing = false
    ringName = ""
    lore = lore + 3
  } else__ {
    "Your hand falters. The ring leaps from the stone and slides to your foot, warm and insistent."
    carryingRing = true
    courage = courage - 2
  }

  choice__
    @target 97
    "Gather the company and move on"
  __choice
__section

section__
  @title "95 — The Singing Stone"

  "At the stone the scholar sings, and the rock answers with images — faces, roads, echoes of those who once bore burdens."
