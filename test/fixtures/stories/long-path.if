settings__
  @storyTitle "The Long Path: An Epic of the Waning Ring"
  @startAt "Prologue: The Quiet Hollow"
  @referrable false
__settings

/* Global variables */
section__
  @title "Prologue: The Quiet Hollow"

  playerName = "Traveler"
  home = "Hollow"
  health = 100
  courage = 10
  carryingRing = false
  ringName = ""
  companions = []
  pathTaken = []
  gold = 0
  lore = 0

  "You remember a place of green hills and smoke curling from small chimneys — the ${home}."
  "You remember simple songs and simpler tasks. But an old road calls you now."

  choice__
    @target 2
    "Begin the tale"
  __choice
__section

section__
  @title "1 — The Farewell"

  "On the eve of leaving, your oldest friend stays late by the gate, wringing a handkerchief."
  "There is an old traveler's pack ready and a crust of bread waiting."

  choice__
    @target 3
    "Say goodbye and set out"
  __choice
__section

section__
  @title "2 — The Road South"

  "The road is well-worn and sings beneath your boots, a low steady rhythm of travel."
  pathTaken.push("road_south")
  "Some distant bell marks the hour. The sun slides low."

  choice__
    @target 4
    "Walk toward the low hills"
  __choice
__section

section__
  @title "3 — The Hollow Gate"
  gold = gold + 5

  "At the gate a small figure presses a parcel into your hands — the handwriting is old-fashioned and cramped."
  "You find 5 gold coins and a folded sketch of a mountain with a red mark on its face."

  choice__
    @target 4
    "Tuck the sketch away and move on"
  __choice
__section

section__
  @title "4 — The Inn of the Turning Road"

  "An inn sits at the crossroad — smoke, voices, the smell of stew. A fireplace is bright and welcoming."
  "You push open the door."

  choice__
    @target 5
    "Speak with the innkeeper"
  __choice

  choice__
    @target 6
    "Listen to the travelers and move on"
  __choice
__section

section__
  @title "5 — Warm Light"

  "The innkeeper hums as he polishes a mug. For a moment the world is nothing but warmth."
  lore = lore + 1

  choice__
    @target 7
    "Ask about the mountains on the sketch"
  __choice
__section

section__
  @title "6 — Passing Whispers"

  "You overhear talk of a strange relic found in a barrow, something small that hums when the moon is full."
  carryingRing = carryingRing || false

  choice__
    @target 7
    "Follow the talk to learn more"
  __choice
__section

section__
  @title "7 — A Stranger at the Table"

  "A tall stranger with weary eyes sits and tells a tale: 'A small band once carried a burden across the lands...'"
  courage = courage + 1
  lore = lore + 1

  choice__
    @target 8
    "Tell the stranger of the folded sketch"
  __choice
__section

section__
  @title "8 — The Sketch Revealed"

  "He takes the sketch slowly. His fingers tremble. 'That mark is old,' he says. 'It points to the Emberface — a clasped summit.'"
  lore = lore + 2

  choice__
    @target 9
    "Ask if he will come with you"
  __choice

  choice__
    @target 10
    "Tell him you'll go alone"
  __choice
__section

section__
  @title "9 — An Oath Sworn"

  "He smiles a tired, honest smile. 'A short company is better than none,' he says, and stands."
  companions.push("Elder stranger")
  courage = courage + 2

  choice__
    @target 11
    "Set out toward Emberface"
  __choice
__section

section__
  @title "10 — A Lone Step"

  "You feel the road more keenly when you walk alone. The hills breathe with wind and the sky is wide."
  pathTaken.push("alone")
  courage = courage + 1

  choice__
    @target 11
    "Continue to the Emberface path"
  __choice
__section

section__
  @title "11 — The Green Border"

  "A ribbon of trees marks the border between past and what comes next. You pass through, and the inn disappears behind you."
  "A narrow lane curves up to the first ridge."

  choice__
    @target 12
    "Climb the ridge"
  __choice
__section

section__
  @title "12 — A Night Camp"

  "You make a small fire; the stars are pricked in the wide sky. The stranger keeps watch."
  health = health + 2
  "You sleep uneasily, dreaming of iron and molten light."

  choice__
    @target 13
    "Follow the lane at dawn"
  __choice
__section

section__
  @title "13 — Crossroads of Wind"

  "A crossroads. A traveler points left and warns of bandits on the west pass; right, he says, is longer but safer."
  choice__
    @target 14
    "Take the dangerous western pass"
  __choice

  choice__
    @target 16
    "Take the long safe road"
  __choice
__section

section__
  @title "14 — The West Pass"

  "The path narrows and cliffs lean over it like watchful gargoyles."
  courage = courage + 1

  choice__
    @target 15
    "Press through the pass"
  __choice
__section

section__
  @title "15 — Ambushed!"

  "A band of thieves drop from the crags. Fight or flight — your muscles remember the training of childhood games."
  health = health - 15
  courage = courage + 1

  choice__
    @target 17
    "You fight and drive them off"
  __choice
__section

section__
  @title "16 — The Long Road"

  "The long road winds like a silver thread. You pass small farms and an orchard heavy with fruit."
  gold = gold + 3

  choice__
    @target 17
    "Visit a farmhouse and ask for directions"
  __choice
__section

section__
  @title "17 — Old Stories"

  "An old woman shows you a map of the Emberface and mentions a ruined watchtower at section 27."
  lore = lore + 1

  choice__
    @target 18
    "Head toward the watchtower"
  __choice
__section

section__
  @title "18 — The Ravine"

  "A ravine cuts the land, spanned by a frail wooden bridge."
  choice__
    @target 19
    "Cross the bridge cautiously"
  __choice

  choice__
    @target 20
    "Find a way around"
  __choice
__section

section__
  @title "19 — Bridge of Shakes"

  "The bridge groans but holds. Midway you see a flash of metal far below."
  carryingRing = carryingRing || false
  pathTaken.push("bridge")

  choice__
    @target 21
    "Hurry across"
  __choice
__section

section__
  @title "20 — A Path Less Shaky"

  "Walking around the ravine takes time, but the fields smell of thyme and you pick a handful."
  gold = gold + 1
  lore = lore + 1

  choice__
    @target 21
    "Rejoin the road"
  __choice
__section

section__
  @title "21 — Watchtower Ruins"

  "A crumbling tower stands sentinel. The stone is carved with strange runes."
  lore = lore + 2

  choice__
    @target 22
    "Search the watchtower"
  __choice

  choice__
    @target 23
    "Keep to the road"
  __choice
__section

section__
  @title "22 — A Hidden Chamber"

  "Beneath loose flagstones you find a small iron ring set with a dull, dark gem — it hums faintly in your hand."
  carryingRing = true
  ringName = "the Humble Ring"
  lore = lore + 3

  choice__
    @target 24
    "Pocket the ring"
  __choice
__section

section__
  @title "23 — The Road Ahead"

  "You pass the tower without looking back. The sky clouds and a hush falls on the road."
  pathTaken.push("past_tower")

  choice__
    @target 24
    "Press onward"
  __choice
__section

section__
  @title "24 — The Burden"

  "At night the ring warms and a small whisper rises — a voice like wind through leaves that says, 'Return...'"
  if__ (carryingRing == true) {
    courage = courage - 1
  }

  choice__
    @target 25
    "Keep it hidden"
  __choice

  choice__
    @target 26
    "Show it to your companion"
  __choice
__section

section__
  @title "25 — Quiet Resolve"

  "You bury unease. Whatever this object is, you will not be tempted by faint words."
  courage = courage + 1

  choice__
    @target 27
    "Continue toward Emberface"
  __choice
__section

section__
  @title "26 — The Stranger's Countenance"

  "The companion's face changes as they touch the ring. 'This is older than I thought,' they whisper. 'It calls to more than the hand.'"
  companions.push("Companion who touched ring")
  lore = lore + 2

  choice__
    @target 27
    "Move on together"
  __choice
__section

section__
  @title "27 — The Fallen Gate"

  "A gateway collapsed ages ago — beyond it smoke rises on the distant ridge where Emberface lives."
  "You note the way ahead is a crooked line of blackened stone."

  choice__
    @target 28
    "Follow the blackened road"
  __choice
__section

section__
  @title "28 — Night at the Fold"

  "A shepherd shares a fire. He speaks of an old name: the Waning Ring — not found since the old wars."
  lore = lore + 1

  choice__
    @target 29
    "Ask more questions"
  __choice

  choice__
    @target 30
    "Leave at first light"
  __choice
__section

section__
  @title "29 — Stories by Firelight"

  "The shepherd tells of a circle of stones and a river that runs backwards during a certain moon."
  lore = lore + 2

  choice__
    @target 30
    "Head out at dawn"
  __choice
__section

section__
  @title "30 — Riverford"

  "At Riverford a small ferry takes you across. Traders glance at your pack and nod."
  gold = gold + 2

  choice__
    @target 31
    "Talk to the ferryman"
  __choice
__section

section__
  @title "31 — The Ferryman's Riddle"

  "He asks: 'What is worn and warmed by those who dread it, yet often returned to the earth?'"
  choice__
    @target 32
    "Answer: 'A burden carried.'"
  __choice

  choice__
    @target 33
    "Answer: 'A ring.'"
  __choice
__section

section__
  @title "32 — The Stern Nod"

  "He nods and rows you across, muttering that riddles are not for those with heavy pockets."
  lore = lore + 1

  choice__
    @target 34
    "Disembark and follow the highroad"
  __choice
__section

section__
  @title "33 — A Quiet Laugh"

  "The ferryman's laugh is not unkind. 'Many rings I have seen in my day, precious and plain. Careful with small things.'"
  lore = lore + 1

  choice__
    @target 34
    "Step onto the far bank"
  __choice
__section

section__
  @title "34 — Road to Emberface"

  "The Emberface is a dark scar against the sky. A little village at its foot looks abandoned."
  "Wind pushes dust across the square."

  choice__
    @target 35
    "Search the village"
  __choice

  choice__
    @target 36
    "Head straight to the Emberface pass"
  __choice
__section

section__
  @title "35 — Echoes in the Square"

  "In the abandoned inn you find graffito that warns: 'Do not call the stone.'"
  lore = lore + 1

  choice__
    @target 36
    "Leave the village"
  __choice
__section

section__
  @title "36 — Emberface Pass"

  "The pass narrows. Black glass-like rock rings beneath your feet. The air smells of old metal."
  health = health - 5

  choice__
    @target 37
    "Keep climbing"
  __choice
__section

section__
  @title "37 — The Red Mark"

  "You find a cleft with a red sigil matching your sketch. A mouth opens in the rock as if awaiting a word."
  if__ (carryingRing == true) {
    "When you step close the ring hums and a thin thread of smoke rises."
  } else__ {
    "The cleft holds only silence and old dust."
  }

  choice__
    @target 38
    "Search the cleft"
  __choice
__section

section__
  @title "38 — The Cavern Mouth"

  "Inside, the cavern breathes. Stalactites like teeth drip slow drops. A stair winds down into the dark."
  lore = lore + 1

  choice__
    @target 39
    "Descend the stair"
  __choice
__section

section__
  @title "39 — The Hall of Echoes"

  "The sound of your steps is multiplied until you cannot tell which voice is your own."
  courage = courage - 1

  choice__
    @target 40
    "Call out a name"
  __choice
__section

section__
  @title "40 — The Answer"

  "From the gloom an old voice replies: 'Who dares stir the ashes of Emberface?'"
  if__ (companions.length > 0) {
    "Your companion steps forward to speak."
  } else__ {
    "You stand alone and small."
  }

  choice__
    @target 41
    "Speak true"
  __choice
__section

section__
  @title "41 — The Keeper"

  "An ancient warden appears — half-shadow, half-wood. He examines you and the small ring in your hand, if you carry it."
  if__ (carryingRing == true) {
    "His eyes linger on the ring, and he warns, 'Some things are worn to be lost, and some are lost to be found.'"
    lore = lore + 2
  } else__ {
    "He simply nods and tells you to move on."
  }

  choice__
    @target 42
    "Ask the warden about the ring"
  __choice

  choice__
    @target 43
    "Leave the Hall"
  __choice
__section

section__
  @title "42 — A Warning Given"

  "The warden speaks of old bargains and lost songs. He says, 'Keep it hidden from those whose eyes long for crowns.'"
  courage = courage - 1

  choice__
    @target 43
    "Take his warning and go"
  __choice
__section

section__
  @title "43 — Down the Pass"

  "You press onward. The wind keens. The path forks toward the summit and into a lower, shadowed way."
  choice__
    @target 44
    "Take the summit path"
  __choice

  choice__
    @target 46
    "Descend into the shadowed way"
  __choice
__section

section__
  @title "44 — Summit Trail"

  "At the summit a ruined altar stands, black and cold. The sky is an iron sheet."
  lore = lore + 1

  choice__
    @target 45
    "Inspect the altar"
  __choice
__section

section__
  @title "45 — The Echoing Altar"

  "The altar shows carvings of battles and a place where a small ring might be held. You realize those runes match the watchtower stones."
  lore = lore + 2

  choice__
    @target 47
    "Choose to leave the ring here for safety"
  __choice

  choice__
    @target 46
    "Keep the ring and leave the summit"
  __choice
__section

section__
  @title "46 — The Gloomway"

  "The shadowed way is damp and smells of old roots. Lanternlight reveals glittering shapes in the soil."
  courage = courage - 1
  health = health - 5

  choice__
    @target 47
    "Enter deeper"
  __choice
__section

section__
  @title "47 — The Fork of Choice"

  "A crossroads in rock. To the east, a river can be heard. To the west, a low hum like distant bells."
  choice__
    @target 48
    "Go east toward the river"
  __choice

  choice__
    @target 49
    "Go west toward the hum"
  __choice
__section

section__
  @title "48 — River Below"

  "The river runs cold. A figure in gray stands on the far bank, watching. He beckons."
  choice__
    @target 50
    "Call back and seek a crossing"
  __choice

  choice__
    @target 51
    "Ignore and follow the river downstream"
  __choice
__section

section__
  @title "49 — The Bells of Stone"

  "The hum resolves into ringing — stone bells set in the cliff-face. They ring with an unnatural timing."
  lore = lore + 1

  choice__
    @target 52
    "Climb to the bells"
  __choice
__section

section__
  @title "50 — The Gray Watcher"

  "He crosses, silent as mist. 'You carry a small burden,' he says. 'Some things should be borne by many.'"
  companions.push("Gray Watcher")
  courage = courage + 2

  choice__
    @target 53
    "Ask him to join you"
  __choice
__section

section__
  @title "51 — Following the Water"

  "Downstream the river breaches a hidden glade where mushrooms glow faint blue."
  gold = gold + 2
  lore = lore + 1

  choice__
    @target 53
    "Rest at the glade"
  __choice
__section

section__
  @title "52 — Bell-Climb"

  "Up at the bells you find an old inscription: 'When the waning returns, bind it with truth.'"
  lore = lore + 2

  choice__
    @target 53
    "Descend and continue"
  __choice
__section

section__
  @title "53 — A Council of Three"

  "Around a low fire you, the stranger, and the watcher speak of purpose. It is decided: you will travel as a company."
  companions.push("Stranger Companion")
  lore = lore + 1

  choice__
    @target 54
    "Formally name your fellowship"
  __choice
__section

section__
  @title "54 — Names Given"

  "You carve a small token and tie it to each pack. 'Fellowship of the Emberstride' you say, and they echo the phrase."
  pathTaken.push("fellowship_formed")
  courage = courage + 2

  choice__
    @target 55
    "Set a plan to reach the Emberface core"
  __choice
__section

section__
  @title "55 — The Long Descent"

  "You take a long descent toward a basin where a city of black glass once stood."
  health = health - 5

  choice__
    @target 56
    "Approach the ruins cautiously"
  __choice
__section

section__
  @title "56 — Ruins of Glass"

  "Broken panes of glass glitter like a thousand eyes. In the center is a shallow pit where heat once rose."
  lore = lore + 1

  choice__
    @target 57
    "Search the pit"
  __choice
__section

section__
  @title "57 — The Pit's Secret"

  "Within the pit you find a small box nailed with iron. Inside, a folded parchment with an old oath."
  lore = lore + 2

  choice__
    @target 58
    "Read the oath aloud"
  __choice
__section

section__
  @title "58 — Words of Binding"

  "The oath speaks of binding a small ring to a pyre when the moon is right. The page ends mid-sentence with scorch marks."
  lore = lore + 2

  choice__
    @target 59
    "Decide whether to follow the oath"
  __choice
__section

section__
  @title "59 — The Decision"

  "The fellowship argues. Some fear the power; others fear keeping it. Voices rise like cupped hands to the sky."
  choice__
    @target 60
    "Bind it to the pyre at the Emberface"
  __choice

  choice__
    @target 61
    "Keep the ring and seek counsel elsewhere"
  __choice
__section

section__
  @title "60 — The Pyre Plan"

  "You move to prepare a pyre at the old altar. Wood must be gathered and a clear wind is needed."
  pathTaken.push("pyre_planned")
  lore = lore + 1

  choice__
    @target 62
    "Gather wood in the valley"
  __choice
__section

section__
  @title "61 — A Different Counsel"

  "You decide to seek the Haven of Elders, a place whispered of where learned ones once sang the old songs."
  pathTaken.push("seek_haven")
  lore = lore + 1

  choice__
    @target 63
    "Set out toward the Haven"
  __choice
__section

section__
  @title "62 — Fires in the Basin"

  "As you gather wood, distant drums begin. Shapes move in the smoke—armored figures riding the wind."
  courage = courage - 2

  choice__
    @target 64
    "Stand and face the riders"
  __choice

  choice__
    @target 66
    "Hide and watch"
  __choice
__section

section__
  @title "63 — Road to Haven"

  "The road bends through a grove of silver-leaved trees; at its heart stands a house with a tall window."
  lore = lore + 1

  choice__
    @target 65
    "Knock on the tall window"
  __choice
__section

section__
  @title "64 — The Riders"

  "Those who come are not thieves; they are the Wardens of Ash — sentinels of the old hush. They seek the ring."
  health = health - 10

  choice__
    @target 67
    "Fight to defend the ring"
  __choice

  choice__
    @target 68
    "Attempt parley"
  __choice
__section

section__
  @title "65 — The House of Windows"

  "A scholar greets you, silver-haired, with eyes like cold glass. 'We have watched Emberface since dawn's first fire,' she says."
  companions.push("Scholar of the Haven")
  lore = lore + 3

  choice__
    @target 69
    "Ask for counsel"
  __choice
__section

section__
  @title "66 — Hidden Shadows"

  "In hiding you watch the riders pass by with banners dipped in ash. They do not stop, but their leader glances upward and their hands search their cloaks."
  pathTaken.push("hid_from_riders")
  courage = courage - 1

  choice__
    @target 67
    "Follow at distance"
  __choice
__section

section__
  @title "67 — Battle at the Basin"

  "Steel flashes and the river turns red at the edges. You fight with desperation and strange effectiveness."
  health = health - 20
  courage = courage + 3

  choice__
    @target 70
    "After the clash, tend the wounded"
  __choice
__section

section__
  @title "68 — Parley"

  "The Warden leader listens. 'Some bear things that bring ruin,' he says. 'We ask to hold it in trust.'"
  choice__
    @target 71
    "Refuse to surrender the ring"
  __choice

  choice__
    @target 72
    "Agree to a temporary handover"
  __choice
__section

section__
  @title "69 — The Scholar's Library"

  "Ancient scrolls speak of a ritual at the river's bend. The scholar says, 'There is a way to test its weight upon the spirit.'"
  lore = lore + 3

  choice__
    @target 73
    "Request the ritual"
  __choice

  choice__
    @target 74
    "Decline and go your own way"
  __choice
__section

section__
  @title "70 — Tending Wounds"

  "You bind cuts with cloth and murmur old blessings. The companion who touched the ring sleeps fitfully."
  health = health + 10

  choice__
    @target 75
    "Move to a safer path"
  __choice
__section

section__
  @title "71 — A Stiff Surrender"

  "Surrender brings them close. They place the object on a stone. But as they do, the leader's hand trembles — his eyes shine with hunger."
  courage = courage - 2

  choice__
    @target 76
    "Seize the ring back and run"
  __choice
__section

section__
  @title "72 — Temporary Trust"

  "They take the ring and swear an oath to return it. You mark their seal and travel on. Yet at night doubt blooms like mildew."
  pathTaken.push("trusted_wardens")
  lore = lore + 1

  choice__
    @target 75
    "Keep moving"
  __choice
__section

section__
  @title "73 — The Spirit Test"

  "By the river the scholar reads an old song and places the ring in clear water. The surface ripples and your reflection shudders."
  if__ (carryingRing == true) {
    "The ring shows a face that is neither yours nor wholly other."
    lore = lore + 3
  } else__ {
    "The water shows only sky."
  }

  choice__
    @target 75
    "Leave the river and decide the next step"
  __choice
__section

section__
  @title "74 — A Lone Road"

  "You decline, feeling the scholar's calm disapproving gaze. The road feels narrower when help is refused."
  courage = courage - 1

  choice__
    @target 75
    "Choose the road south"
  __choice
__section

section__
  @title "75 — Through the Thicket"

  "Thorns catch cloak and flesh. You cut your way through with patience and a small knife."
  health = health - 5

  choice__
    @target 77
    "Press on toward the lowlands"
  __choice
__section

section__
  @title "76 — Running with the Ring"

  "You snatch back the ring. Splinters of trust scatter like birds. You run, heart drum-fast, and the land blurs."
  carryingRing = true
  courage = courage - 1

  choice__
    @target 77
    "Find shelter beyond the next rise"
  __choice
__section

section__
  @title "77 — A Hidden Vale"

  "A secret vale cradles a clear pool where willow branches dip their hair. In the pool floats a small leaf with a mark similar to the ring's."
  lore = lore + 1

  choice__
    @target 78
    "Rest and wash away the dust"
  __choice
__section

section__
  @title "78 — Dreams by Water"

  "Your dreams are filled with marching feet and a bell tolling far to the south. You wake with ash in your hair."
  pathTaken.push("dreams_of_bell")
  courage = courage - 1

  choice__
    @target 79
    "Head south toward the bell"
  __choice
__section

section__
  @title "79 — The Bell of Torrow"

  "At Torrow an ancient bell hangs in a ruin and is rung on rare days of warning."
  lore = lore + 1

  choice__
    @target 80
    "Climb the ruin"
  __choice
__section

section__
  @title "80 — The Tolling"

  "From the ruin the view is wide. You see smoke on a distant plain to the east — a sign of an army in motion."
  pathTaken.push("saw_smoke_east")
  courage = courage + 1

  choice__
    @target 81
    "Ride east to the smoke"
  __choice
__section

section__
  @title "81 — Plain of Ash"

  "On the plain, banners of a strange design ripple. They are not friendly. The riders march in ordered lines."
  health = health - 10

  choice__
    @target 82
    "Skirmish at the fringe"
  __choice

  choice__
    @target 83
    "Skirt the plain and avoid the army"
  __choice
__section

section__
  @title "82 — Skirmish"

  "You and your small band harry a supply column and slip away with a satchel of preserved meat and an iron token."
  gold = gold + 4
  courage = courage + 2

  choice__
    @target 84
    "Head toward the Emberface core"
  __choice
__section

section__
  @title "83 — Avoiding the Army"

  "You travel the long way, along a marsh where reeds whisper. A lonely heron lifts and goes."
  health = health - 2

  choice__
    @target 84
    "Move on"
  __choice
__section

section__
  @title "84 — The Lower Gates"

  "You reach a low gate half-sunk into a field of glass. A small inscription reads: 'None pass who bear no vow.'"
