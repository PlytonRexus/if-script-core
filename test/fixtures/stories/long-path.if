  choice__
    @target 87
    "Talk to the sentinel"
  __choice
__section

section__
  @title "87 — Hall Beneath the Plain"

  "Beneath the glass plain an ancient hall opens, frescoes half erased by heat. At its center is a shallow throne of cooled slag."
