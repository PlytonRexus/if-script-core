section__
  @title "Moat Cailin Whispered Warning at the gatehouse"
  @textPacing "cinematic"
  @shot "wide"
  @backdrop "https://example.com/thrones/02-act2-riverlands/frame-114.jpg"

  "A Moat Cailin warning reaches your command: bridge pylons north of the Neck are being sabotaged by men posing as relief guards. Arya pushes for immediate public accusation. Beric urges restraint until names are certain, warning that one false claim could split the last cooperative houses.

A major banner threatens to withdraw grain teams unless you prove who is behind the sabotage before dawn. Public process could hold the coalition together if evidence survives scrutiny. Covert retaliation could stop more sabotage tonight while handing rivals proof that Valehart governs through secret violence. In a starving theater, infrastructure is legitimacy.

River mist crawls through the sept doors while engineers await escort orders. Every hour lost here fractures both roads and alliances."

  choice__
    @target "Oldtown Silent Betrayal behind closed doors"
    @action honor = clampStat(honor + 2, 0, 30)
    @action war_readiness = clampStat(war_readiness + 1, 0, 30)
    @action survival_clock = clampStat(survival_clock - 1, 0, 30)
    "Issue a public sabotage inquiry, lock suspected crossings under witness guard, and prioritize legitimacy over immediate vengeance."
  __choice

  choice__
    @target "Pyke Hostage Exchange at the broken tower"
    @when ((secrecy + leverage) >= 7)
    @action ruthlessness = clampStat(ruthlessness + 2, 0, 30)
    @action secrecy = clampStat(secrecy + 1, 0, 30)
    @action leverage = clampStat(leverage + 1, 0, 30)
    @action survival_clock = clampStat(survival_clock - 1, 0, 30)
