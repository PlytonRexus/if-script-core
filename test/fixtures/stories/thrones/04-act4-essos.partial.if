    @action secrecy = clampStat(secrecy + 1, 0, 30)
    @action wealth = clampStat(wealth + 1, 0, 30)
    @action leverage = clampStat(leverage + 1, 0, 30)
    @action survival_clock = clampStat(survival_clock - 1, 0, 30)
    "Move frontier funds through shell accounts and coercive favors, preserving cash flow while risking exposure and scandal"
  __choice

  choice__
    @target "T255 - ACT4 - Oldtown Silent Betrayal behind closed doors"
