    @action war_readiness = clampStat(war_readiness + 2, 0, 30)
    @action survival_clock = clampStat(survival_clock - 1, 0, 30)
    "Recognize the inheritance claim in open hearing, accepting short-term friction to preserve lawful supply legitimacy"
  __choice

