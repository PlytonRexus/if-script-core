    @target "Qarth Alliance Split near the godswood"
    @action honor = clampStat(honor + 2, 0, 30)
    @action war_readiness = clampStat(war_readiness + 1, 0, 30)
    @action survival_clock = clampStat(survival_clock - 1, 0, 30)
    "Convene the captains on the quay and issue one public command charter, trading flexibility for immediate legitimacy."
  __choice

