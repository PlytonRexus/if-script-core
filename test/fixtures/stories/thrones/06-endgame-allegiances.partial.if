    @action leverage = clampStat(leverage + 2, 0, 30)
    @action survival_clock = clampStat(survival_clock - 1, 0, 30)
    "Cut a midnight command deal with key officers, sacrificing transparency to neutralize rivals before dawn."
  __choice

  choice__
